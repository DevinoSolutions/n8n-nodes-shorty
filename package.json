{
	"name": "n8n-nodes-shorty",
	"version": "0.1.0",
	"description": "n8n community node for Shorty: summarize YouTube videos, web pages and text, transcribe audio and video links, read your summary library, and start workflows when a Shorty job finishes.",
	"license": "MIT",
	"homepage": "https://github.com/DevinoSolutions/n8n-nodes-shorty#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"shorty",
		"summarizer",
		"youtube-summary",
		"transcription",
		"podcast",
		"ai-summary"
	],
	"author": {
		"name": "Devino Solutions",
		"email": "support@aishorty.com",
		"url": "https://aishorty.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevinoSolutions/n8n-nodes-shorty.git"
	},
	"bugs": {
		"url": "https://github.com/DevinoSolutions/n8n-nodes-shorty/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.test.json && vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ShortyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Shorty/Shorty.node.js",
			"dist/nodes/ShortyTrigger/ShortyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^22.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.2",
		"typescript": "5.9.2",
		"vitest": "4.1.12"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
